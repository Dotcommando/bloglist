                "properties": {
                  "id": {
                    "bsonType": [
                      "int",
                      "double"
                    ],
                    "minimum": 1
                  },
                  "parentId": {
                    "bsonType": [
                      "int",
                      "double",
                      "null"
                    ]
                  },
                  "stage": {
                    "enum": [
                      "site",
                      "route",
                      "activation",
                      "plan",
                      "request",
                      "runtime",
                      "tokenization",
                      "parameters",
                      "preparation",
                      "snippet",
                      "deduplication",
                      "input",
                      "output",
                      "worker-queue",
                      "worker-startup",
                      "script",
                      "bridge",
                      "transfer",
                      "cleanup",
                      "composition",
                      "validation",
                      "assets",
                      "json-ld",
                      "style-hashes",
                      "markdown",
                      "artifact",
                      "snippet-scheduling"
                    ]
                  },
                  "offsetMs": {
                    "bsonType": [
                      "int",
                      "double"
                    ],
                    "minimum": 0
                  },
                  "durationMs": {
                    "bsonType": [
                      "int",
                      "double"
                    ],
                    "minimum": 0
                  },
                  "outcome": {
                    "enum": [
                      "Success",
                      "Failure",
                      "Aborted",
                      "Timeout",
                      "Fallback"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "indexes": [
        {
          "name": "page_resolution_site_time",
          "key": {
            "siteId": 1,
            "startedAt": 1
          }
        },
        {
          "name": "page_resolution_site_version_time",
          "key": {
            "siteId": 1,
            "cmsVersion": 1,
            "startedAt": 1
          }
        },
        {
          "name": "page_resolution_retention",
