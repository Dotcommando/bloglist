{
  "id": "0009-parallel-snippet-execution",
  "collections": [
    {
      "name": "rendering_elements",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": [
            "_id",
            "siteId",
            "kind",
            "key",
            "version",
            "html",
            "css",
            "browserTypeScript",
            "parameters",
            "createdAt",
            "updatedAt",
            "backupState",
            "name"
          ],
          "properties": {
