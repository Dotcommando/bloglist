{
  "name": "cms-zarya",
  "version": "0.16.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "release:pack": "node scripts/release-artifact.mjs pack",
    "release:verify": "node scripts/release-artifact.mjs verify",
    "addon:pack": "npm run build:server && node dist/pack-addon-package.js",
    "cdn:prepare": "npm run build:server && node --env-file-if-exists=.env dist/prepare-cloudflare.js",
    "deploy:cloudflare": "npm run build:server && node --env-file-if-exists=.env dist/prepare-cloudflare.js --deploy",
    "deploy:executor": "node --env-file-if-exists=.env dist/deployment-executor.js",
    "deployment": "node --env-file-if-exists=.env dist/deployment.js",
    "build": "node scripts/build.mjs",
    "build:runtime-addons": "node dist/build-addon-packages.js",
    "typecheck": "npm run typecheck:server && npm run typecheck --workspace @zarya/admin",
    "format": "eslint . --fix",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:gateway": "vitest run test/adapters/cloudflare-worker.spec.ts test/adapters/cloudflare-worker-bundle.spec.ts test/adapters/edge-proxy.spec.ts",
    "test:release:admin": "node --env-file-if-exists=.env scripts/test-admin-release.mjs",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.config.integration.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:http": "node --env-file-if-exists=.env dist/public-http.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "migrate:verify": "node --env-file-if-exists=.env dist/migrate.js --verify",
    "migrate:media": "node --env-file-if-exists=.env dist/migrate-media-layout.js",
    "build:server": "npm run build:contracts && tsc -p tsconfig.build.json",
    "typecheck:server": "npm run build:contracts && tsc --noEmit",
    "dev:admin": "npm run dev --workspace @zarya/admin",
    "build:contracts": "npm run build --workspace @zarya/addon-contracts",
    "migrate:publications": "node --env-file-if-exists=.env scripts/migrate-publication-layout.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "12.2.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/html-minifier-terser": "7.0.2",
    "@types/negotiator": "0.6.5",
    "@types/node": "24.0.0",
    "@types/sanitize-html": "2.16.2",
    "@types/sax": "1.2.7",
    "@types/turndown": "5.0.6",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "9.39.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "16.5.0",
    "playwright-core": "1.64.1",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@xmldom/xmldom": "0.9.12",
    "@zarya/addon-contracts": "0.6.0",
    "@zarya/addon-contracts-retained-0-4": "file:packages/retained-contracts/zarya-addon-contracts-0.4.0.tgz",
    "@zarya/addon-contracts-retained-0-5": "file:packages/retained-contracts/zarya-addon-contracts-0.5.0.tgz",
    "cssnano": "9.9.0",
    "esbuild": "0.28.2",
    "file-type": "22.2.0",
    "html-minifier-terser": "7.2.0",
    "javascript-obfuscator": "4.1.1",
    "marked": "18.1.1",
    "mongoose": "9.11.4",
    "negotiator": "1.1.0",
    "parse-srcset": "1.0.2",
    "parse5": "8.0.1",
    "parse5-sax-parser": "8.0.0",
    "postcss": "8.5.31",
    "postcss-value-parser": "4.2.0",
    "reflect-metadata": "0.2.2",
    "robots-parser": "3.0.1",
    "rxjs": "7.8.1",
    "sanitize-html": "2.18.1",
    "sax": "1.6.1",
    "sharp": "0.35.5",
    "stream-json": "3.8.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "ws": "8.21.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "workspaces": [
    "admin",
    "packages/addon-contracts"
  ]
}
