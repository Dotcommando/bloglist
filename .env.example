ZARYA_MONGO_URI=mongodb://127.0.0.1:27040/?directConnection=true
ZARYA_MONGO_DATABASE=zarya_clean_local
ZARYA_LOCAL_OPERATOR_ID=local-operator
ZARYA_LOCAL_ADMINISTRATOR=true
ZARYA_TEST_MONGO_URI=mongodb://127.0.0.1:27040/?directConnection=true
# Optional built synthetic runtime package, installed only in the isolated CMS API test.
ZARYA_TEST_SYNTHETIC_ADDON_DIRECTORY=
ZARYA_SITES_ROOT=./sites
ZARYA_ARTIFACTS_ROOT=./artifacts
# Private site dumps, outside public assets and source/media roots.
ZARYA_DUMPS_ROOT=./dumps
# Persistent media storage for local operations, Files and public HTTP delivery.
ZARYA_MEDIA_ROOT=./data
ZARYA_MEDIA_PUBLIC_PATH=/assets
ZARYA_HTTP_HOST=127.0.0.1
ZARYA_HTTP_PORT=3001

# Prepared automatically from package.json before Compose builds.
ZARYA_CMS_VERSION=0.17.0
# Optional explicit installation CPU budget; omit to detect affinity/quota.
# ZARYA_INSTALLATION_CPU_BUDGET=2
ZARYA_INFRASTRUCTURE_CPU_RESERVE=0
# Managed Docker only: configure both, otherwise CPU quota control is unavailable.
# ZARYA_RESOURCE_SOCKET=/run/zarya/resources.sock
# ZARYA_RESOURCE_SECRET_FILE=/run/secrets/resource-control-key
# Resource-helper startup only: trusted loopback HTTP listener for full calibration.
# ZARYA_CALIBRATION_TARGET_ORIGIN=http://127.0.0.1:3000
# Optional authenticated Cloudflare-to-backend proxy; configure the same secret in the Worker.
ZARYA_EDGE_PROXY_SECRET=
# For noninteractive deployment; otherwise use npm exec -- wrangler login.
# CLOUDFLARE_ACCOUNT_ID=account-id
# CLOUDFLARE_API_TOKEN=secret
# Private persistent executor workspace; never serve it as static assets.
ZARYA_DEPLOYMENT_ROOT=./.cloudflare
# Initial installation administration origin (seeded once into MongoDB).
# Change it later in Installation settings; use HTTPS outside localhost.
ZARYA_ADMIN_AUTH_ORIGIN=http://localhost:3001
ZARYA_ADMIN_ROOT=./admin/dist
# Optional access to private add-on repositories. The absolute directory contains GitHub App PEM files.
# ZARYA_GITHUB_APP_CLIENT_ID=github-app-client-id
# ZARYA_GITHUB_APP_KEYS_DIR=/run/secrets/github-app
# Optional host directory for Docker; defaults to ./.secrets/github-app.
# ZARYA_GITHUB_APP_HOST_KEYS_DIR=./.secrets/github-app
# Set to the installed Chromium/Chrome executable for browser integration tests.
ZARYA_TEST_BROWSER_EXECUTABLE=/usr/bin/chromium

# Private document timing; records are written only after the response ends.
ZARYA_PAGE_DIAGNOSTICS=true

# One bounded process-owned pool for edited Snippets (Build, Request and preview).
ZARYA_SNIPPET_POOL_SIZE=4
ZARYA_SNIPPET_POOL_QUEUE_LIMIT=256
ZARYA_SNIPPET_POOL_QUEUE_WAIT_MS=1000
ZARYA_SNIPPET_POOL_EXECUTION_TIMEOUT_MS=10000
ZARYA_SNIPPET_POOL_MEMORY_BUDGET_MB=512

# Opted-in side-effect-free Snippets share render/process admission limits.
ZARYA_SNIPPET_PARALLEL_PER_RENDER=4
ZARYA_SNIPPET_PARALLEL_PER_PROCESS=16
ZARYA_SNIPPET_PARALLEL_QUEUE_LIMIT=256
ZARYA_SNIPPET_PARALLEL_QUEUE_WAIT_MS=10000

# Bounded in-process Request document cache; each page opts in at publication.
ZARYA_REQUEST_CACHE_MAX_ENTRIES=256
ZARYA_REQUEST_CACHE_MAX_BODY_BYTES=2097152
ZARYA_REQUEST_CACHE_MAX_TOTAL_BYTES=33554432

# Explicit database location/control: ManagedLocal, UnmanagedLocal or Remote.
ZARYA_DATABASE_PLACEMENT=ManagedLocal
# UnmanagedLocal requires an explicit application CPU budget; Remote can use detection.
# ZARYA_CMS_CPU_BUDGET=1
# Coordinator pool and initial site pool size; admin changes site pools live.
# Independent of the permitted site-process count.
ZARYA_MONGO_MAX_POOL_SIZE=5
